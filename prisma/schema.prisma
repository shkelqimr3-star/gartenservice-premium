generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  priceNote   String?
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  location    String?
  description String
  beforeImage String?
  afterImage  String
  serviceType String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessSettings {
  id          String   @id @default("business")
  companyName String   @default("Gartenservice Sami & Co.")
  phone       String   @default("+49 176 41178833")
  whatsapp    String   @default("+4917641178833")
  email       String   @default("hotis@outlook.de")
  address     String   @default("Etzwiesenstrasse 7, 71522 Backnang")
  serviceArea String   @default("Backnang und Umgebung")
  heroTitle   String   @default("Zuverlaessiger Gartenservice in Backnang und Umgebung")
  heroText    String   @default("Wir kuemmern uns um Hecken, Rasen, Baumarbeiten und laufende Gartenpflege. Sauber, termintreu und mit direktem Ansprechpartner vor Ort.")
  heroImage   String?
  updatedAt   DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  message   String
  service   String?
  status    String   @default("Neu")
  createdAt DateTime @default(now())
}
